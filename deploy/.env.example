# 仅绑定 Hermes 服务器的局域网地址，不要改成 0.0.0.0 后再做公网映射。
# Replace this example with the actual LAN address of the host running Mosquitto.
MQTT_BIND_ADDRESS=192.168.1.10
MQTT_USERNAME=s7
MQTT_PASSWORD=replace-with-a-long-random-password

# Hermes 服务器上的 persistent data directory.
HERMES_SCALE_DIR=/srv/hermes-s7/data/weight

# 容器以这个 UID/GID 写入上述目录。
HERMES_SCALE_UID=10001
HERMES_SCALE_GID=10001

# 健康检查只绑定 127.0.0.1。
HEALTH_PORT=18087

# 仅在 [pai].enabled=true 时需要；文件权限必须是 0600，且 owner/group 要与
# HERMES_SCALE_UID/GID 一致，供 native Docker installer 内的 collector 读取。
PAI_AUTH_FILE=/srv/hermes-s7/pai-auth.json
